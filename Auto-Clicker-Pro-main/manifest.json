{
    "manifest_version": 3,
    "name": "Auto Clicker Pro",
    "version": "4.1",
    "description": "An advanced auto clicker with a mouse recorder to automate click sequences and form filling.",
    "permissions": ["contextMenus", "scripting", "activeTab", "storage", "downloads", "clipboardRead", "clipboardWrite"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"],
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": ["icons/icon48.png"],
            "matches": ["<all_urls>"]
        }
    ]
}
